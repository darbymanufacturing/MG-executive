# Omni — environment variables (example / documentation)
# Copy to `.env` (gitignored) for local dev, and set the same keys in the
# Vercel project env for production. Full inventory + sensitivity notes live in
# docs/SECURITY.md → "Secrets inventory".

# --- Sentry error capture ---
# Public-by-design DSN: a write-only ingest key (it can SEND events, never read
# them), so it is safe to embed in the client bundle. Capture is enabled only in
# production builds — set VITE_SENTRY_FORCE=true to test from a local prod build.
VITE_SENTRY_DSN=https://4dcbf95fc1a756334b0cefcc83181af2@o4511404632113152.ingest.de.sentry.io/4511472399089744
# VITE_SENTRY_FORCE=true   # uncomment to enable Sentry in a local/dev build (testing only)

# --- Firebase web app (public-by-design key) ---
# REQUIRED — admin account creation (createTechnicianAccount) fails with a
# Google 400 if this is unset. Same value as the web API key in src/lib/firebase.js.
VITE_FIREBASE_WEB_API_KEY=

# --- Dev toggles ---
# VITE_USE_PROD_FIRESTORE=true   # opt out of the local Firebase emulator in dev (hit prod Firestore)
