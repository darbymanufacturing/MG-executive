# Omni — environment variables (example / documentation)
# Copy to `.env` (gitignored) for local dev, and set the same keys in the
# Vercel project env for production. Full inventory + sensitivity notes live in
# docs/SECURITY.md → "Secrets inventory".

# --- Sentry error capture ---
# Public-by-design DSN: a write-only ingest key (it can SEND events, never read
# them), so it is safe to embed in the client bundle. Capture is enabled only in
# production builds — set VITE_SENTRY_FORCE=true to test from a local prod build.
VITE_SENTRY_DSN=https://4dcbf95fc1a756334b0cefcc83181af2@o4511404632113152.ingest.de.sentry.io/4511472399089744
# VITE_SENTRY_FORCE=true   # uncomment to enable Sentry in a local/dev build (testing only)

# --- Firebase web app (public-by-design key) ---
# REQUIRED — admin account creation (createTechnicianAccount) fails with a
# Google 400 if this is unset. Set this to the Web API key shown in the Firebase console (Project Settings > General > Web API key).
VITE_FIREBASE_WEB_API_KEY=

# --- Dev toggles ---
# VITE_USE_PROD_FIRESTORE=true   # opt out of the local Firebase emulator in dev (hit prod Firestore)

# --- Supabase (ADR-0013 time-series + ADR-0015 operational data layer) ---
# Public-by-design (RLS is the security boundary), safe to embed in the client bundle.
# IMPORTANT: VITE_* vars are baked at BUILD time. Changing them locally requires
# restarting Vite (Ctrl+C -> npm run dev); in production you must REDEPLOY to apply.
# See docs/runbooks/supabase-migration.md.
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-publishable-key>
# Global default store: supabase (default post-ADR-0015) | firestore (rollback). Anything else logs an error
# and falls back to firestore. Flip only after backfill + parity check.
VITE_DATA_LAYER=supabase
# ADR-0015 — per-collection override (wins over the global) for incremental cutover.
# Comma list of `collection:layer` pairs, e.g. "costs:supabase,issues:supabase".
# VITE_DATA_LAYER_OVERRIDES=

# --- Supabase server-only — NEVER commit / never ship to the client (Vercel env + secrets/) ---
# Service role bypasses RLS; used by scripts/backfill-firestore-to-supabase.mjs + cron dual-write.
# SUPABASE_URL=https://nbvfgciyuuclgssnnzlt.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # Supabase dashboard → Project Settings → API → service_role

# --- Cloudinary (server-only — NEVER use VITE_ prefix for these; they must never reach the bundle) ---
# Used by api/cloudinary-sign.js (signed upload) and api/cloudinary-delete.js (asset deletion).
# Client bundle uses VITE_CLOUDINARY_CLOUD_NAME (read-only, safe to expose) only for image display.
# Obtain from: Cloudinary Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=          # also set as VITE_CLOUDINARY_CLOUD_NAME for client image display
CLOUDINARY_API_KEY=             # the numeric API key (e.g. 123456789012345)
CLOUDINARY_API_SECRET=          # the secret — treat like a password; never commit or log
